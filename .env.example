# Copy to .env (never commit .env)
PORT=3000
DATABASE_URL=postgres://deskbuddy:deskbuddy@localhost:5432/deskbuddy
# Set to true for managed Postgres that requires TLS (Neon, Supabase, Cloud SQL public IP, etc.)
DATABASE_SSL=false

# Demo clock: owners not checked in by this local time (Asia/Kuala_Lumpur) free their desk
RELEASE_CUTOFF=10:00

# Person A fills these in later
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
SLACK_CHANNEL_ID=
LLM_API_KEY=

# Copy to .env (never commit .env). What each one does: README › Environment variables.
PORT=3000
DATABASE_URL=postgres://deskbuddy:deskbuddy@localhost:5432/deskbuddy
# Set to true for managed Postgres that requires TLS (Neon, Supabase, Cloud SQL public IP, etc.)
DATABASE_SSL=false

# Shown by /api/clock and /api/floor only. Desks are NOT auto-released any more (12 Nov):
# silence means "in the office"; a desk frees when its owner says they're out.
RELEASE_CUTOFF=10:00

# Reading Slack (Socket Mode): all three, or the listener stays off.
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
SLACK_CHANNEL_ID=
# Optional: pin Slack members to demo staff ("U0AAA:u-meiling,U0BBB:u-hafiz"). Anyone else is auto-linked.
# Real member IDs go in Railway / your local .env only, never in git.
SLACK_USER_MAP=
# Sign in with Slack + Connect Slack (OpenID Connect).
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
# Two-way Slack status (DeskBuddy → Slack): "on" only once the Slack app has the User Token Scopes
# users.profile:read + users.profile:write. Off = no Connect Slack button; reading statuses still works.
SLACK_STATUS_SYNC=
# Not used yet: the status parser is rule-based. Reserved for an LLM parser.
LLM_API_KEY=
